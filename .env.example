# Crewlink Environment Configuration
# Copy this file to .env and fill in your values.

# Server settings
PORT=3000
APP_URL=http://localhost:3000
NODE_ENV=development

# PostgreSQL Database URL (Supabase, Neon, Railway, AWS RDS, or local Docker)
# e.g., postgresql://postgres:password@localhost:5432/crewlink?schema=public
# or Supabase: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:password@localhost:5432/crewlink?schema=public

# Session security (generate a random 32+ character string)
SESSION_SECRET=change-this-to-a-secure-random-string-at-least-32-chars

# GitHub OAuth App credentials (from GitHub Developer Settings -> OAuth Apps)
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret

# Optional GitHub App settings (if using a GitHub App instead of OAuth App for invitations)
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY_PATH=
