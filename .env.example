# Crewlink Environment Configuration
# Copy this file to .env and fill in your values.

# Server settings
# Production requires an HTTPS APP_URL, NODE_ENV=production, unique 32+ character
# secrets, a PostgreSQL DATABASE_URL and an explicit PUBLISHING_TRANSPORT.
# Startup validation rejects localhost, placeholder secrets and the file store.
PORT=3100
APP_URL=http://localhost:3100
NODE_ENV=development

# PostgreSQL Database URL (Supabase, Neon, Railway, AWS RDS, or local Docker)
# e.g., postgresql://postgres:password@localhost:5432/crewlink?schema=public
# or Supabase: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:password@localhost:5432/crewlink?schema=public

# Session & encryption security (generate random 32+ character strings).
# These placeholders are DEV ONLY; production startup rejects them.
SESSION_SECRET=change-this-to-a-secure-random-string-at-least-32-chars
ENCRYPTION_SECRET=change-this-to-a-secure-32-character-encryption-secret

# GitHub OAuth App credentials (from GitHub Developer Settings -> OAuth Apps)
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret

# GitHub Webhook Secret (for verifying incoming events from GitHub)
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret

# Optional Transactional Notification Webhook (e.g., Slack, Discord, internal service, or Zapier)
NOTIFICATION_WEBHOOK_URL=

# Optional GitHub App settings (if using a GitHub App instead of OAuth App for invitations)
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY_PATH=
GITHUB_APP_PRIVATE_KEY_PATH=

# Google Cloud Storage for applicant resumes (PDFs)
# Leave GCS_BUCKET_NAME empty to keep resumes on local disk in data/uploads (dev/tests only).
GCS_BUCKET_NAME=
GCP_PROJECT_ID=
# Optional: paste the service-account key JSON as a single line. If empty, the SDK uses
# GOOGLE_APPLICATION_CREDENTIALS or the machine's Application Default Credentials.
GCS_CREDENTIALS_JSON=

# Social publishing credentials
# `local` encrypts social tokens with versioned AES-256-GCM derived from ENCRYPTION_SECRET_V*.
# `gcp` encrypts with Google Cloud KMS and fails closed if KMS is unreachable (no fallback).
CREDENTIAL_PROVIDER=local
# `env` reads application-level secrets from the variables below.
# `gcp` reads them from Secret Manager (GOOGLE_CLOUD_PROJECT required) and fails closed.
SECRETS_PROVIDER=env

# Crewlink-owned Discord and Telegram applications (Milestone 2).
# These are application-level bot tokens, never per-creator tokens. They are read
# server-side only and are never returned by an API or sent to browser JavaScript.
DISCORD_BOT_TOKEN=
TELEGRAM_BOT_TOKEN=
# `mock` (default) uses deterministic in-memory Discord/Telegram clients.
# `live` makes real Discord Bot API v10 / Telegram Bot API / X API calls; it
# requires the bot tokens above, real channel ids, and the X app credentials below.
# `mock` is the safe development/test default. Production startup REQUIRES an
# explicit value of `mock` or `live`; it never silently chooses one. `mock` uses
# deterministic fake clients and makes no platform network calls.
PUBLISHING_TRANSPORT=mock

# Bluesky AT Protocol service for creator-owned accounts (default bsky.social).
BLUESKY_SERVICE_URL=https://bsky.social

# X (Twitter) automatic publishing (Milestone 4).
# One Crewlink-owned OAuth 2.0 app bills every automatic post. Owners never paste
# X tokens. Leave X_CLIENT_ID empty to keep manual publishing only: the connect
# route and automatic publish fail closed, while manual publishing stays free.
X_CLIENT_ID=
X_CLIENT_SECRET=
X_API_BASE_URL=https://api.x.com
X_AUTHORIZE_URL=https://x.com/i/oauth2/authorize
# App-wide monthly ceiling in USD for Crewlink-billed X create requests.
# An invalid or negative value fails closed to 0 (automatic publishing stops).
# Manual publishing never charges and is not limited by this value.
X_MONTHLY_BUDGET_USD=10

# Reddit publishing (Milestone 5).
# Create a "web app" OAuth client at https://www.reddit.com/prefs/apps and use its
# client id/secret. Requests use the official OAuth API only; Crewlink never asks
# for a Reddit password, session cookie, or app password. Leave REDDIT_CLIENT_ID
# empty to keep Reddit disconnected: the connect route fails closed.
# REDDIT_USER_AGENT must be unique and descriptive; Reddit may block generic agents.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=crewlink/0.1 (Crewlink publishing)
REDDIT_AUTHORIZE_URL=https://www.reddit.com/api/v1/authorize
REDDIT_TOKEN_URL=https://www.reddit.com/api/v1/access_token
REDDIT_REVOKE_URL=https://www.reddit.com/api/v1/revoke_token
REDDIT_API_BASE_URL=https://oauth.reddit.com
# Documented non-commercial OAuth ceiling, used for guidance and error messages.
# Commercial/high-volume use needs Reddit approval; see TODO.md.
REDDIT_RATE_LIMIT_PER_MINUTE=100

# LinkedIn publishing (Milestone 6).
# Create a LinkedIn app with "Sign In with LinkedIn using OpenID Connect" and
# "Share on LinkedIn" products. Requested scopes are openid profile
# w_member_social only. Crewlink never asks for a LinkedIn password. Leave
# LINKEDIN_CLIENT_ID empty to keep LinkedIn disconnected: connecting and
# automatic publishing fail closed, while drafts stay editable.
# The callback URL is derived from APP_URL:
#   {APP_URL}/api/platforms/linkedin/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Versioned Posts API header, YYYYMM. Leave empty to use the documented default
# (currently 202610). Each version is supported for at least 12 months; a
# malformed or sunset value fails closed with a clear error. Check LinkedIn's
# versioning page before an upgrade.
LINKEDIN_API_VERSION=202610
LINKEDIN_API_BASE_URL=https://api.linkedin.com
LINKEDIN_AUTHORIZE_URL=https://www.linkedin.com/oauth/v2/authorization
LINKEDIN_TOKEN_URL=https://www.linkedin.com/oauth/v2/accessToken
# Member post analytics need the Community Management API and the
# r_member_postAnalytics scope. Keep this false until LinkedIn approves the app.
LINKEDIN_ANALYTICS_ENABLED=false

# Slack publishing (Milestone 7).
# Create a Slack app, add the OAuth bot scopes chat:write, channels:read and
# groups:read (no user scopes), then install it to the workspace you want to
# test with. Crewlink stores only the bot token, encrypted with the M1 vault.
# Leave SLACK_CLIENT_ID empty to keep Slack disconnected: connecting and
# automatic publishing fail closed, while drafts stay editable.
# The callback URL is derived from APP_URL:
#   {APP_URL}/api/platforms/slack/callback
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_AUTHORIZE_URL=https://slack.com/oauth/v2/authorize
SLACK_TOKEN_URL=https://slack.com/api/oauth.v2.access
SLACK_API_BASE_URL=https://slack.com/api
# PUBLISHING_TRANSPORT=mock (the default) keeps Slack in a deterministic fake
# client; set it to live only for an approved live test.
#
# WhatsApp is manual-only: no Business API, no Meta credentials, no OAuth.
# Crewlink builds an official https://wa.me/ share link and the owner sends the
# message in WhatsApp by hand. Nothing is configured here.

# AI workspace (Milestone 8).
# AI_PROVIDER selects exactly one provider. There is no automatic fallback:
# `unconfigured` (the production default) disables generation with a clear
# message, `mock` is deterministic and makes no network calls, and the others
# require their own key below. API keys are read server-side only and are never
# returned to the browser or written to an execution log.
AI_PROVIDER=unconfigured
AI_MODEL=
AI_TIMEOUT_MS=30000
AI_MAX_RETRIES=1
AI_MAX_OUTPUT_TOKENS=2048
AI_MAX_LLM_CALLS_PER_CAMPAIGN=160
AI_MAX_DURATION_DAYS=30
AI_MAX_IDEAS_PER_CAMPAIGN=40
AI_VARIATIONS_PER_IDEA=2
AI_EXECUTION_BUDGET_MS=90000
AI_MIN_SCHEDULE_GAP_MINUTES=120

# OpenAI Chat Completions (only used when AI_PROVIDER=openai).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=

# Anthropic Messages API (only used when AI_PROVIDER=anthropic).
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=

# Google Gemini API (only used when AI_PROVIDER=gemini).
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_MODEL=

# Research uses documented search APIs only.
# `none` records questions and unverified assumptions without pretending to have
# sources. `brave` needs BRAVE_SEARCH_API_KEY. `reddit` reuses the Reddit OAuth
# client above with Reddit's app-only token (public search only). `both` uses
# whichever provider is configured and never scrapes a page behind a login.
AI_RESEARCH_PROVIDER=none
BRAVE_SEARCH_API_KEY=
BRAVE_SEARCH_URL=https://api.search.brave.com/res/v1/web/search

# Analytics (Milestone 9).
# Sync is an explicit owner action. It is bounded by a post count and a deadline,
# and snapshots are pruned so storage growth stays predictable. There is no
# background worker. PUBLISHING_TRANSPORT=mock still selects deterministic fake
# analytics clients, so a local run makes no platform calls.
ANALYTICS_MAX_POSTS_PER_SYNC=50
ANALYTICS_SYNC_TIMEOUT_MS=20000
# Database lease for one project/platform sync. Must be greater than the timeout.
ANALYTICS_SYNC_LEASE_MS=120000
ANALYTICS_SNAPSHOT_RETENTION_DAYS=365
ANALYTICS_SNAPSHOT_MAX_PER_ENTITY=60
# Posting-time suggestions need at least this many measured posts across 3+ days.
ANALYTICS_MIN_SAMPLE_FOR_TIMING=8
# Optional external scheduler credential. Leave empty to disable
# POST /api/analytics/sync/scheduled. When set it must be at least 32 characters.
# Send it as `x-crewlink-scheduler-token` or `Authorization: Bearer <token>`.
ANALYTICS_SCHEDULER_TOKEN=

# Google Cloud credential settings (only needed when CREDENTIAL_PROVIDER or SECRETS_PROVIDER is gcp)
# Full CryptoKey resource name:
# projects/PROJECT/locations/LOCATION/keyRings/RING/cryptoKeys/KEY
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_KMS_KEY=
GOOGLE_CLOUD_LOCATION=
# Secret names are prefixed with this value, e.g. crewlink-discord-client-secret
GOOGLE_SECRET_MANAGER_PREFIX=crewlink-
# Optional private bucket for encrypted credential backups. Never store plaintext there.
GOOGLE_CLOUD_STORAGE_BUCKET=

# Optional versioned local encryption keys. The highest ENCRYPTION_SECRET_Vn wins for
# new ciphertext; older versions stay readable so keys can be rotated without data loss.
ENCRYPTION_SECRET_V1=
ENCRYPTION_SECRET_V2=
