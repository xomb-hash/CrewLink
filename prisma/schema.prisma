datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id          String      @id
  login       String      @unique
  name        String?
  avatarUrl   String?
  createdAt   DateTime    @default(now())
  publicRepos Int         @default(0)
  accessToken String?
  updatedAt   DateTime    @updatedAt
  projects    Project[]
  applicants  Applicant[]
  sessions    Session[]

  @@map("users")
}

model Session {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("sessions")
}

model Project {
  id           String      @id @default(cuid())
  slug         String      @unique
  ownerLogin   String
  ownerId      String
  ownerAvatar  String?
  repoFullName String
  repoName     String
  repoOwner    String
  isPrivate    Boolean     @default(false)
  joinMode     String      @default("referral")
  screeningUrl String?
  roles        String[]    @default([])
  title        String
  description  String?
  creatorNote  String?
  requireResume       Boolean @default(false)
  requireGithubLink   Boolean @default(false)
  requireLinkedinLink Boolean @default(false)
  referralCode String?
  referralCodeCreatedAt DateTime?
  referralCodeUsedAt DateTime?
  logoPath     String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  owner        User        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  applicants   Applicant[]
  drafts       Draft[]

  @@index([ownerLogin])
  @@index([ownerId])
  @@map("projects")
}

model Draft {
  id           String      @id @default(cuid())
  projectId    String
  platformId   String
  text         String
  status       String      @default("drafted")
  approvedText String?
  approvedHash String?
  approvedAt   DateTime?
  approvedBy   String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  project      Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("drafts")
}


model Applicant {
  id                String   @id @default(cuid())
  projectId         String
  userId            String
  userLogin         String
  userAvatar        String?
  accountAge        String
  publicRepoCount   Int      @default(0)
  message           String?
  githubUrl         String?
  linkedinUrl       String?
  resumeFileName    String?
  resumePath        String?
  status            String   @default("pending")
  invitationSent    Boolean  @default(false)
  invitationDetails Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  project           Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
  @@map("applicants")
}
